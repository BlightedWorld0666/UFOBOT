DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional. Riot production API access may be required for account ID lookup.
RIOT_API_KEY=

# Hub local-only health endpoint (disabled unless key is provided)
HUB_API_KEY=
HUB_PORT=8791
# Discord channel IDs; optional. Rank events are staff-confirmed, not automatic Riot sync.
RANK_LOG_CHANNEL_ID=
LFG_CHANNEL_ID=

# UFO Bot community features
XP_ENABLED=true
# Optional Discord category to house /tempvoice rooms
TEMPVOICE_CATEGORY_ID=

# Dashboard (separate local admin service; do not put real secrets in this file in Git)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8792
DASHBOARD_USERNAME=Admin
# Generate these locally using npm run admin:setup
DASHBOARD_PASSWORD_HASH=
DASHBOARD_MASTER_KEY=
# Only enable when serving via a correctly configured HTTPS reverse proxy
DASHBOARD_SECURE_COOKIE=false
